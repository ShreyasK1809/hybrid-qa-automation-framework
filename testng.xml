<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Hybrid Framework - Full Regression" parallel="methods" thread-count="4"
       data-provider-thread-count="4" verbose="1">
  <listeners>
    <listener class-name="com.framework.listeners.TestListener"/>
    <listener class-name="com.framework.listeners.RetryListener"/>
  </listeners>

  <test name="UI Tests">
    <classes>
      <class name="com.framework.tests.ui.LoginTest"/>
      <class name="com.framework.tests.ui.CheckoutTest"/>
    </classes>
  </test>

  <test name="API Tests">
    <classes>
      <class name="com.framework.tests.api.UserApiTest"/>
    </classes>
  </test>
</suite>
